<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- 디자인 규격표 (docs/design/design-tokens.md). 화면에 쓰는 글자 크기·높이·간격·반경·아이콘 크기는 여기 값만 쓴다. -->

  <!-- 글자 크기 4단계 -->
  <x:Double x:Key="FontSizeCaption">11</x:Double>
  <x:Double x:Key="FontSizeBody">12.5</x:Double>
  <x:Double x:Key="FontSizeSubtitle">14</x:Double>
  <x:Double x:Key="FontSizeTitle">16</x:Double>

  <!-- 컨트롤 높이 3단계 -->
  <x:Double x:Key="ControlHeightS">24</x:Double>
  <x:Double x:Key="ControlHeightM">28</x:Double>
  <x:Double x:Key="ControlHeightL">32</x:Double>

  <!-- 간격 (StackPanel.Spacing 등 숫자) -->
  <x:Double x:Key="Space4">4</x:Double>
  <x:Double x:Key="Space8">8</x:Double>
  <x:Double x:Key="Space12">12</x:Double>
  <x:Double x:Key="Space16">16</x:Double>
  <!-- 같은 간격 (Margin·Padding 등 네 변 같은 값) -->
  <Thickness x:Key="Inset4">4</Thickness>
  <Thickness x:Key="Inset8">8</Thickness>
  <Thickness x:Key="Inset12">12</Thickness>
  <Thickness x:Key="Inset16">16</Thickness>
  <!-- 대화 상자 바깥 여백, 대화 상자 단추 최소 폭 -->
  <Thickness x:Key="InsetDialog">24,20,24,16</Thickness>
  <x:Double x:Key="ButtonMinWidth">88</x:Double>

  <!-- 모서리 반경 -->
  <CornerRadius x:Key="RadiusS">4</CornerRadius>
  <CornerRadius x:Key="RadiusL">8</CornerRadius>

  <!-- 아이콘 크기 -->
  <x:Double x:Key="IconSizeS">12</x:Double>
  <x:Double x:Key="IconSizeM">16</x:Double>
  <x:Double x:Key="IconSizeL">20</x:Double>

  <!-- Fluent 테마 기본 글자 크기(14)를 본문 크기로 덮어쓴다. 단추·입력칸·체크 상자·메뉴가 모두 이 값을 쓴다. -->
  <x:Double x:Key="ControlContentThemeFontSize">12.5</x:Double>
</ResourceDictionary>
