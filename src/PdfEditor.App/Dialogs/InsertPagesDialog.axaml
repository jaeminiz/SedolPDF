<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="using:PdfEditor.App.Resources"
        x:Class="PdfEditor.App.Dialogs.InsertPagesDialog"
        Title="{x:Static res:Strings.Dlg_InsertTitle}"
        SizeToContent="Height" Width="420"
        CanResize="False" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        Background="#F3F3F3">
  <StackPanel Margin="24,20,24,16" Spacing="10">
    <TextBlock x:Name="SourceText" TextWrapping="Wrap" Foreground="#1A1A1A" FontWeight="SemiBold" />
    <TextBlock Text="{x:Static res:Strings.Dlg_InsertPosition}" Foreground="#5C5C5C" Margin="0,6,0,0" />
    <RadioButton x:Name="AfterCurrentRadio" GroupName="pos" IsChecked="True" Content="{x:Static res:Strings.Dlg_PosAfterCurrent}" />
    <RadioButton x:Name="FirstRadio" GroupName="pos" Content="{x:Static res:Strings.Dlg_PosFirst}" />
    <RadioButton x:Name="LastRadio" GroupName="pos" Content="{x:Static res:Strings.Dlg_PosLast}" />
    <TextBlock Text="{x:Static res:Strings.Dlg_InsertRange}" Foreground="#5C5C5C" Margin="0,6,0,0" TextWrapping="Wrap" />
    <TextBox x:Name="RangeBox" />
    <TextBlock x:Name="ErrorText" TextWrapping="Wrap" Foreground="#C42B1C" IsVisible="False"
               Text="{x:Static res:Strings.Err_PageRangeInvalid}" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,8,0,0">
      <Button x:Name="OkButton" Classes="accent" IsDefault="True" MinWidth="88" Content="{x:Static res:Strings.Dlg_Ok}" />
      <Button x:Name="CancelButton" IsCancel="True" MinWidth="88" Content="{x:Static res:Strings.Dlg_Cancel}" />
    </StackPanel>
  </StackPanel>
</Window>
