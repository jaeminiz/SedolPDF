<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="using:PdfEditor.App.Resources"
        x:Class="PdfEditor.App.Dialogs.RecoveryDialog"
        Title="{x:Static res:Strings.Dlg_RecoveryTitle}"
        SizeToContent="Height" Width="520"
        CanResize="False" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        Background="#F3F3F3">
  <StackPanel Margin="{DynamicResource InsetDialog}" Spacing="{DynamicResource Space12}">
    <TextBlock Text="{x:Static res:Strings.Dlg_RecoveryMessage}" TextWrapping="Wrap" Foreground="#1A1A1A" />
    <StackPanel x:Name="ItemsPanel" Spacing="{DynamicResource Space8}" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="{DynamicResource Space8}" Margin="0,8,0,0">
      <Button x:Name="OkButton" Classes="accent" IsDefault="True" MinWidth="{DynamicResource ButtonMinWidth}" Content="{x:Static res:Strings.Dlg_Ok}" />
      <Button x:Name="LaterButton" IsCancel="True" MinWidth="{DynamicResource ButtonMinWidth}" Content="{x:Static res:Strings.Dlg_RecoveryLater}" />
    </StackPanel>
  </StackPanel>
</Window>
