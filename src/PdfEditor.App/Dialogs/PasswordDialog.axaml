<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="using:PdfEditor.App.Resources"
        x:Class="PdfEditor.App.Dialogs.PasswordDialog"
        Title="{x:Static res:Strings.Dlg_PasswordTitle}"
        SizeToContent="Height" Width="400"
        CanResize="False" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        Background="#F3F3F3">
  <StackPanel Margin="24,20,24,16" Spacing="12">
    <TextBlock x:Name="PromptText" TextWrapping="Wrap" Foreground="#1A1A1A" />
    <TextBlock x:Name="RetryText" TextWrapping="Wrap" Foreground="#C42B1C" IsVisible="False"
               Text="{x:Static res:Strings.Dlg_PasswordRetry}" />
    <TextBox x:Name="PasswordBox" PasswordChar="*" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,8,0,0">
      <Button x:Name="OkButton" Classes="accent" IsDefault="True" MinWidth="88" Content="{x:Static res:Strings.Dlg_Ok}" />
      <Button x:Name="CancelButton" IsCancel="True" MinWidth="88" Content="{x:Static res:Strings.Dlg_Cancel}" />
    </StackPanel>
  </StackPanel>
</Window>
