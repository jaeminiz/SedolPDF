<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="PdfEditor.App.Dialogs.MessageDialog"
        SizeToContent="WidthAndHeight" MinWidth="360" MaxWidth="680"
        CanResize="False" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        Background="#F3F3F3">
  <StackPanel Margin="{DynamicResource InsetDialog}" Spacing="20">
    <TextBlock x:Name="MessageText" TextWrapping="Wrap" Foreground="#1A1A1A" />
    <StackPanel x:Name="ButtonPanel" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="{DynamicResource Space8}" />
  </StackPanel>
</Window>
