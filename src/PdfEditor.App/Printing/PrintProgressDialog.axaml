<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="using:PdfEditor.App.Resources"
        x:Class="PdfEditor.App.Printing.PrintProgressDialog"
        Title="{x:Static res:Strings.Dlg_PrintProgressTitle}"
        SizeToContent="Height" Width="340"
        CanResize="False" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        Background="#F3F3F3">
  <StackPanel Margin="{DynamicResource InsetDialog}" Spacing="{DynamicResource Space12}">
    <TextBlock x:Name="StatusText" />
    <ProgressBar x:Name="Bar" Minimum="0" />
    <Button x:Name="CancelButton" HorizontalAlignment="Right" MinWidth="{DynamicResource ButtonMinWidth}" Content="{x:Static res:Strings.Dlg_Cancel}" />
  </StackPanel>
</Window>
