<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="using:PdfEditor.App.Resources"
        xmlns:shell="using:PdfEditor.App.Shell"
        xmlns:rb="using:PdfEditor.App.Shell.Ribbon"
        xmlns:docs="using:PdfEditor.App.Documents"
        xmlns:viewer="using:PdfEditor.App.Viewer"
        xmlns:panels="using:PdfEditor.App.Panels"
        x:Class="PdfEditor.App.Shell.MainWindow"
        x:DataType="shell:MainWindowViewModel"
        Title="{x:Static res:Strings.App_Name}"
        Width="1280" Height="800" MinWidth="900" MinHeight="560"
        Background="#F3F3F3"
        TransparencyLevelHint="Mica, None"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="40">
  <Window.Styles>
    <Style Selector="Button.quick">
      <Setter Property="Width" Value="30" />
      <Setter Property="Height" Value="28" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="#1A1A1A" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.quick:disabled">
      <Setter Property="Foreground" Value="#9A9A9A" />
    </Style>
    <Style Selector="Button.quick:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.nav:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.nav">
      <Setter Property="Padding" Value="6,3" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="#1A1A1A" />
    </Style>
    <Style Selector="Button.nav:disabled">
      <Setter Property="Foreground" Value="#9A9A9A" />
    </Style>
    <Style Selector="TextBox.quickbox, TextBox.pagebox">
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Padding" Value="4,2" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="TextBox.quickbox">
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="TextBox.quickbox:focus /template/ Border#PART_BorderElement, TextBox.quickbox:pointerover /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>

    <!-- 메뉴 탭 -->
    <Style Selector="Button.menutab">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="#5C5C5C" />
      <Setter Property="Padding" Value="12,0,12,7" />
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="VerticalAlignment" Value="Bottom" />
    </Style>
    <Style Selector="Button.menutab:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.menutab.on">
      <Setter Property="Foreground" Value="#1A1A1A" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Border.tabline">
      <Setter Property="Height" Value="3" />
      <Setter Property="CornerRadius" Value="2" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Margin" Value="12,0,12,2" />
    </Style>
    <Style Selector="Border.tabline.on">
      <Setter Property="Background" Value="#005FB8" />
    </Style>
    <Style Selector="Button.filetab">
      <Setter Property="Background" Value="#005FB8" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="CornerRadius" Value="4,4,0,0" />
      <Setter Property="Padding" Value="12,5,12,7" />
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="VerticalAlignment" Value="Bottom" />
    </Style>
    <Style Selector="Button.filetab:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#0A6BC8" />
      <Setter Property="TextElement.Foreground" Value="White" />
    </Style>

    <!-- 패널 전환 막대 -->
    <Style Selector="Button.rail">
      <Setter Property="Width" Value="34" />
      <Setter Property="Height" Value="34" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="#1A1A1A" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="CornerRadius" Value="4" />
    </Style>
    <Style Selector="Button.rail.on">
      <Setter Property="Background" Value="#1A005FB8" />
      <Setter Property="Foreground" Value="#005FB8" />
    </Style>
    <Style Selector="Button.rail.on:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#1A005FB8" />
    </Style>
    <Style Selector="Border.railbar">
      <Setter Property="Width" Value="3" />
      <Setter Property="CornerRadius" Value="2" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="Margin" Value="-5,9" />
    </Style>
    <Style Selector="Border.railbar.on">
      <Setter Property="Background" Value="#005FB8" />
    </Style>

    <Style Selector="Border.card">
      <Setter Property="Background" Value="#FBFBFB" />
      <Setter Property="BorderBrush" Value="#17000000" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
    </Style>

    <!-- 문서 탭 -->
    <Style Selector="ListBox.doctabs">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="ListBox.doctabs > ListBoxItem">
      <Setter Property="Padding" Value="12,0,4,0" />
      <Setter Property="Height" Value="28" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="CornerRadius" Value="6,6,0,0" />
      <Setter Property="Foreground" Value="#5C5C5C" />
      <Setter Property="FontSize" Value="11.5" />
    </Style>
    <Style Selector="ListBox.doctabs > ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#D4D4D9" />
      <Setter Property="TextElement.Foreground" Value="#1A1A1A" />
    </Style>
    <Style Selector="Button.tabclose">
      <Setter Property="Width" Value="20" />
      <Setter Property="Height" Value="20" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
  </Window.Styles>

  <Grid RowDefinitions="40,34,Auto,*,30">
    <!-- 1. 제목 표시줄 -->
    <shell:TitleBar Name="TitleBarView" Grid.Row="0" />

    <!-- 2. 메뉴 탭 -->
    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="8,0" Spacing="2">
      <Button Name="FileTabButton" Classes="filetab" Content="{x:Static res:Strings.Tab_File}" />
      <ItemsControl ItemsSource="{Binding RibbonTabs}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="2" /></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="shell:RibbonTabVm">
            <StackPanel VerticalAlignment="Bottom">
              <Button Classes="menutab" Classes.on="{Binding IsSelected}" Content="{Binding Label}" Click="OnRibbonTabClick" />
              <Border Classes="tabline" Classes.on="{Binding IsSelected}" />
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>

    <!-- 3. 리본 -->
    <Border Grid.Row="2" Classes="card" Margin="8,0" Padding="4,4" MinHeight="74">
      <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
        <ItemsControl ItemsSource="{Binding CurrentRibbonGroups}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="rb:RibbonGroupVm">
              <rb:RibbonGroup Header="{Binding Name}" IsCompact="{Binding Compact}" ItemsSource="{Binding Items}">
                <rb:RibbonGroup.ItemTemplate>
                  <DataTemplate x:DataType="rb:RibbonButtonVm">
                    <Panel>
                      <rb:RibbonButton Label="{Binding Label}" IconKey="{Binding Command.IconKey}" IsVisible="{Binding !IsMore}"
                                       Command="{Binding Command.Command}" IsLarge="{Binding IsLarge}" IsChecked="{Binding IsChecked}"
                                       ToolTip.Tip="{Binding Tip}" ToolTip.ShowOnDisabled="True" />
                      <rb:RibbonMoreButton Label="{Binding Label}" IconKey="more" IsVisible="{Binding IsMore}"
                                           Items="{Binding MoreItems}" IsLarge="{Binding IsLarge}" />
                    </Panel>
                  </DataTemplate>
                </rb:RibbonGroup.ItemTemplate>
              </rb:RibbonGroup>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Border>

    <!-- 4. 본문 -->
    <Grid Grid.Row="3" ColumnDefinitions="44,Auto,*,Auto" Margin="8,8,8,0">
      <ItemsControl Grid.Column="0" ItemsSource="{Binding PanelButtons}" VerticalAlignment="Top" Margin="0,6,0,0">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="shell:PanelButtonVm">
            <Panel Width="34" Height="34" Margin="0,2" HorizontalAlignment="Center">
              <Border Classes="railbar" Classes.on="{Binding IsSelected}" />
              <Button Classes="rail" Classes.on="{Binding IsSelected}" ToolTip.Tip="{Binding Label}" Click="OnPanelButtonClick">
                <res:IconView Key="{Binding IconKey}" Width="18" Height="18" />
              </Button>
            </Panel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <Border Grid.Column="1" Classes="card" Width="200" IsVisible="{Binding IsLeftPanelVisible}" ClipToBounds="True">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="{Binding ActivePanelLabel}" FontWeight="SemiBold" Margin="10,8" />
          <Border DockPanel.Dock="Top" Height="1" Background="#17000000" />
          <Panel IsVisible="{Binding ShowThumbnails}"><panels:ThumbnailsPanel DataContext="{Binding ActiveThumbnails}" /></Panel>
          <Panel IsVisible="{Binding ShowBookmarks}"><panels:BookmarksPanel DataContext="{Binding ActiveBookmarks}" /></Panel>
          <Panel IsVisible="{Binding ShowAttachments}"><panels:AttachmentsPanel DataContext="{Binding ActiveAttachments}" /></Panel>
          <Panel IsVisible="{Binding ShowLayers}"><panels:LayersPanel DataContext="{Binding ActiveLayers}" /></Panel>
          <Panel IsVisible="{Binding ShowComments}"><panels:CommentsPanel /></Panel>
          <Panel IsVisible="{Binding ShowSearch}"><panels:SearchPanel x:Name="SearchPanelView" DataContext="{Binding ActiveSearch}" /></Panel>
        </DockPanel>
      </Border>

      <Border Grid.Column="2" Margin="8,0,0,0" CornerRadius="8,8,0,0" BorderBrush="#17000000" BorderThickness="1,1,1,0" ClipToBounds="True">
        <Grid RowDefinitions="32,*">
          <Grid ColumnDefinitions="*,Auto" Background="#F3F3F3">
            <ListBox Classes="doctabs" ItemsSource="{Binding Documents}" SelectedItem="{Binding ActiveDocument}"
                     VerticalAlignment="Bottom">
              <ListBox.ItemsPanel>
                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="2" /></ItemsPanelTemplate>
              </ListBox.ItemsPanel>
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="docs:DocumentTabViewModel">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
                    <Button Classes="tabclose" ToolTip.Tip="{x:Static res:Strings.Tip_CloseTab}" Click="OnTabCloseClick">
                      <res:IconView Key="close" Width="10" Height="10" />
                    </Button>
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <Button Grid.Column="1" Classes="quick" Width="28" Height="26" VerticalAlignment="Bottom" Margin="2,0,6,1"
                    Command="{Binding OpenCommand}" ToolTip.Tip="{x:Static res:Strings.Tip_NewTab}">
              <res:IconView Key="plus" Width="14" Height="14" />
            </Button>
          </Grid>
          <Border Grid.Row="1" Background="#D4D4D9">
            <Grid RowDefinitions="Auto,Auto,*">
              <Border Grid.Row="0" Background="#FFF4CE" Padding="12,6" IsVisible="{Binding ActiveDocument.IsEditRestricted, FallbackValue=False}">
                <TextBlock Text="{x:Static res:Strings.Msg_EditRestricted}" Foreground="#1A1A1A" TextWrapping="Wrap" />
              </Border>
              <Border Grid.Row="1" Background="#FFF4CE" Padding="12,6" IsVisible="{Binding ActiveDocument.HasAnnotationNotice, FallbackValue=False}">
                <TextBlock Text="{Binding ActiveDocument.AnnotationNotice}" Foreground="#1A1A1A" TextWrapping="Wrap" />
              </Border>
              <ScrollViewer Grid.Row="2" Name="DocScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                            IsVisible="{Binding !HasNoDocument}">
                <viewer:DocumentView Tab="{Binding ActiveDocument}" />
              </ScrollViewer>
            <TextBlock Grid.Row="1" Text="{x:Static res:Strings.Msg_NoDocument}" IsVisible="{Binding HasNoDocument}"
                       Foreground="#5C5C5C" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>
          </Border>
        </Grid>
      </Border>

      <Border Grid.Column="3" Classes="card" Width="220" Margin="8,0,0,0" IsVisible="{Binding IsPropertiesPanelVisible}" ClipToBounds="True">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="{x:Static res:Strings.Panel_Properties}" FontWeight="SemiBold" Margin="10,8" />
          <Border DockPanel.Dock="Top" Height="1" Background="#17000000" />
          <Panel>
            <Panel IsVisible="{Binding !HasNoDocument}"><panels:PropertiesPanel DataContext="{Binding ActiveProperties}" /></Panel>
            <TextBlock Text="{x:Static res:Strings.Panel_PropertiesEmpty}" IsVisible="{Binding HasNoDocument}"
                       Foreground="#5C5C5C" Margin="10" TextWrapping="Wrap" />
          </Panel>
        </DockPanel>
      </Border>
    </Grid>

    <!-- 5. 상태 표시줄 -->
    <shell:StatusBar Grid.Row="4" />
  </Grid>
</Window>
