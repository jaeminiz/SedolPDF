<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="PdfEditor.App.App"
             RequestedThemeVariant="Light">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://PdfEditor.App/Resources/Icons.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://PdfEditor.App/Shell/Ribbon/RibbonStyles.axaml" />
    <Style Selector="Window">
      <Setter Property="FontFamily" Value="Segoe UI Variable Text, Malgun Gothic" />
    </Style>
  </Application.Styles>
</Application>
