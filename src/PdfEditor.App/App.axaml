<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="PdfEditor.App.App"
             RequestedThemeVariant="Light">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://SedolPDF/Resources/Icons.axaml" />
        <ResourceInclude Source="avares://SedolPDF/Styles/DesignTokens.axaml" />
        <ResourceInclude Source="avares://SedolPDF/Styles/ControlThemes.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <!-- 선택 색(켜진 토글·슬라이더 등)은 Windows 시스템 강조색(기기마다 청록 등) 대신 리본과 같은 파랑(WinAccent #005FB8)으로 고정한다. -->
    <FluentTheme>
      <FluentTheme.Palettes>
        <ColorPaletteResources x:Key="Light" Accent="#005FB8" />
        <ColorPaletteResources x:Key="Dark" Accent="#005FB8" />
      </FluentTheme.Palettes>
    </FluentTheme>
    <StyleInclude Source="avares://SedolPDF/Shell/Ribbon/RibbonStyles.axaml" />
    <StyleInclude Source="avares://SedolPDF/Styles/ControlStyles.axaml" />
    <Style Selector="Window">
      <Setter Property="FontFamily" Value="Segoe UI Variable Text, Malgun Gothic" />
    </Style>
    <!-- Avalonia 12가 직접 그리는 창 장식(ExtendClientAreaToDecorationsHint)에서 시안에 없는 두 부품을 숨긴다:
         왼쪽 위 창 제목 글자(PART_TitleTextPanel 안의 TextBlock)와 최소화 왼쪽의 전체 화면 버튼(PART_FullScreenButton, "⤡").
         작업 표시줄 이름은 Window.Title이 그대로 쓴다. 이름은 12.1.4 시각 트리에서 확인(M1 마무리 검토). -->
    <!-- 패널 자체의 IsVisible은 장식 코드가 다시 켜므로 안의 글자를 숨긴다. -->
    <Style Selector="Panel#PART_TitleTextPanel > TextBlock">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="Button#PART_FullScreenButton">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <!-- 세 단추를 오른쪽 끝에 붙이는 일은 고정 값(47px)이 아니라 MainWindow.AlignCaptionButtons가 실제 위치를 재서 한다.
         고정 값으로 밀면 환경에 따라 닫기 단추가 화면 밖으로 나갔다(0.11.0 사용자 보고). -->
    <!-- Windows 11 모양: 제목 줄 높이를 꽉 채우는 46px 단추, 가리키면 옅은 회색, 닫기는 빨강(#C42B1C)에 흰 글자. -->
    <Style Selector="Button#PART_MinimizeButton, Button#PART_MaximizeButton, Button#PART_CloseButton">
      <Setter Property="Width" Value="46" />
      <Setter Property="Height" Value="40" />
      <Setter Property="MinWidth" Value="46" />
      <Setter Property="MinHeight" Value="40" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="0" />
    </Style>
    <Style Selector="Button#PART_MinimizeButton:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button#PART_MaximizeButton:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#0D000000" />
    </Style>
    <Style Selector="Button#PART_MinimizeButton:pressed /template/ ContentPresenter#PART_ContentPresenter, Button#PART_MaximizeButton:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#08000000" />
    </Style>
    <Style Selector="Button#PART_CloseButton:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#C42B1C" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button#PART_CloseButton:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#B3C42B1C" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <!-- 글자 모양은 단추 안의 도형이라 도형 색도 바꿔야 흰 X가 된다. -->
    <Style Selector="Button#PART_CloseButton:pointerover Path, Button#PART_CloseButton:pressed Path">
      <Setter Property="Fill" Value="White" />
    </Style>
  </Application.Styles>
</Application>
