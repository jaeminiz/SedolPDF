<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <RootNamespace>PdfEditor.App</RootNamespace>
    <AssemblyName>SedolPDF</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Pdf.Native\Pdf.Native.csproj" />
    <ProjectReference Include="..\PdfEditor.Document\PdfEditor.Document.csproj" />
    <ProjectReference Include="..\PdfEditor.Appearance\PdfEditor.Appearance.csproj" />
    <ProjectReference Include="..\PdfEditor.Pages\PdfEditor.Pages.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\LICENSE" Link="LICENSE" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\THIRD-PARTY-NOTICES.md" Link="THIRD-PARTY-NOTICES.md" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\assets\fonts\OFL.txt" Link="assets\fonts\OFL.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\assets\licenses\pdfium\*" Link="licenses\pdfium\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Resources\Strings.resx">
      <LogicalName>PdfEditor.App.Resources.Strings.resources</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
