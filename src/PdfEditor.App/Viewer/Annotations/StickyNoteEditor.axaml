<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="using:PdfEditor.App.Resources"
             x:Class="PdfEditor.App.Viewer.Annotations.StickyNoteEditor">
  <Border Background="#FBFBFB" BorderBrush="#33000000" BorderThickness="1" CornerRadius="6" Padding="{DynamicResource Inset8}">
    <StackPanel Spacing="{DynamicResource Space8}">
      <TextBlock Name="Header" FontSize="{DynamicResource FontSizeCaption}" Foreground="#5C5C5C" />
      <TextBox Name="Box" Width="240" Height="160" AcceptsReturn="True" TextWrapping="Wrap"
               PlaceholderText="{x:Static res:Strings.Sticky_Placeholder}" />
      <TextBlock Text="{x:Static res:Strings.Sticky_Hint}" FontSize="{DynamicResource FontSizeCaption}" Foreground="#5C5C5C" />
    </StackPanel>
  </Border>
</UserControl>
