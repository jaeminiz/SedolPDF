<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="using:PdfEditor.App.Resources"
             xmlns:panels="using:PdfEditor.App.Panels"
             x:Class="PdfEditor.App.Panels.PropertiesPanel"
             x:DataType="panels:PropertiesViewModel">
  <UserControl.Styles>
    <Style Selector="TextBlock.k">
      <Setter Property="Foreground" Value="#5C5C5C" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Margin" Value="0,8,0,0" />
    </Style>
    <Style Selector="TextBlock.v">
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
  </UserControl.Styles>
  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <Panel>
    <StackPanel Margin="10,0,10,10" IsVisible="{Binding IsDocumentMode}">
      <TextBlock Classes="k" Text="{x:Static res:Strings.Prop_FileName}" />
      <TextBlock Classes="v" Text="{Binding FileName}" />
      <TextBlock Classes="k" Text="{x:Static res:Strings.Prop_PageCount}" />
      <TextBlock Classes="v" Text="{Binding PageCount}" />
      <TextBlock Classes="k" Text="{x:Static res:Strings.Prop_PageSize}" />
      <TextBlock Classes="v" Text="{Binding PageSizeText}" />
      <TextBlock Classes="k" Text="{x:Static res:Strings.Prop_PdfVersion}" />
      <TextBlock Classes="v" Text="{Binding PdfVersion}" />
      <TextBlock Classes="k" Text="{x:Static res:Strings.Prop_Title}" />
      <TextBlock Classes="v" Text="{Binding Title}" />
      <TextBlock Classes="k" Text="{x:Static res:Strings.Prop_Author}" />
      <TextBlock Classes="v" Text="{Binding Author}" />
      <TextBlock Classes="k" Text="{x:Static res:Strings.Prop_Creator}" />
      <TextBlock Classes="v" Text="{Binding Creator}" />
      <TextBlock Classes="k" Text="{x:Static res:Strings.Prop_Producer}" />
      <TextBlock Classes="v" Text="{Binding Producer}" />
      <TextBlock Classes="k" Text="{x:Static res:Strings.Prop_Encrypted}" />
      <TextBlock Classes="v" Text="{Binding Encrypted}" />
      <TextBlock Classes="k" Text="{x:Static res:Strings.Prop_PermPrint}" />
      <TextBlock Classes="v" Text="{Binding PrintPermission}" />
      <TextBlock Classes="k" Text="{x:Static res:Strings.Prop_PermEditPages}" />
      <TextBlock Classes="v" Text="{Binding EditPagesPermission}" />
      <TextBlock Classes="k" Text="{x:Static res:Strings.Prop_PermCopy}" />
      <TextBlock Classes="v" Text="{Binding CopyPermission}" />
      <TextBlock Classes="k" Text="{x:Static res:Strings.Prop_Repaired}" />
      <TextBlock Classes="v" Text="{Binding Repaired}" />
    </StackPanel>
    <StackPanel x:Name="AnnotSection" Margin="10,0,10,10" IsVisible="{Binding !IsDocumentMode}" x:DataType="panels:PropertiesViewModel">
      <TextBlock Text="{Binding Annotation.KindName}" FontWeight="SemiBold" />
      <TextBlock Classes="k" Text="{x:Static res:Strings.Prop_Annot_DefaultsHint}" TextWrapping="Wrap" x:Name="DefaultsHint" />
      <TextBlock Classes="k" Text="{x:Static res:Strings.Prop_Annot_Color}" />
      <WrapPanel x:Name="ColorSwatches" />
      <TextBlock Classes="k" Text="{x:Static res:Strings.Prop_Annot_Mixed}" x:Name="MixedHint" />
      <StackPanel x:Name="FillSection">
        <TextBlock Classes="k" Text="{x:Static res:Strings.Prop_Annot_Fill}" />
        <WrapPanel x:Name="FillSwatches" />
      </StackPanel>
      <StackPanel x:Name="WidthSection">
        <TextBlock Classes="k" Text="{Binding Annotation.WidthLabel}" />
        <Slider x:Name="WidthSlider" Minimum="0.5" Maximum="12" TickFrequency="0.5" IsSnapToTickEnabled="True" />
      </StackPanel>
      <StackPanel x:Name="LineStyleSection">
        <TextBlock Classes="k" Text="{x:Static res:Strings.Prop_Annot_LineStyle}" />
        <ComboBox x:Name="LineStyleBox" HorizontalAlignment="Stretch" />
      </StackPanel>
      <StackPanel x:Name="LineEndSection">
        <TextBlock Classes="k" Text="{x:Static res:Strings.Prop_Annot_LineStart}" />
        <ComboBox x:Name="StartEndBox" HorizontalAlignment="Stretch" />
        <TextBlock Classes="k" Text="{x:Static res:Strings.Prop_Annot_LineEnd}" />
        <ComboBox x:Name="EndEndBox" HorizontalAlignment="Stretch" />
        <Button x:Name="BothArrowsBtn" Margin="0,6,0,0" Content="{x:Static res:Strings.Prop_Annot_BothArrows}"
                ToolTip.Tip="{x:Static res:Strings.Prop_Annot_BothArrowsTip}" />
      </StackPanel>
      <StackPanel x:Name="LeaderSection">
        <TextBlock Classes="k" Text="{x:Static res:Strings.Prop_Annot_Leaders}" />
        <Button x:Name="LeaderAddBtn" Content="{x:Static res:Strings.Prop_Annot_LeaderAdd}"
                ToolTip.Tip="{x:Static res:Strings.Prop_Annot_LeaderAddTip}" />
        <Button x:Name="LeaderRemoveBtn" Margin="0,4,0,0" Content="{x:Static res:Strings.Prop_Annot_LeaderRemove}" />
      </StackPanel>
      <StackPanel x:Name="CloudSection">
        <CheckBox x:Name="CloudCheck" Margin="0,8,0,0" Content="{x:Static res:Strings.Prop_Annot_Cloud}" />
        <TextBlock Classes="k" Text="{Binding Annotation.CloudIntensityLabel}" />
        <NumericUpDown x:Name="CloudBox" Minimum="0.5" Maximum="2" Increment="0.5" FormatString="0.0" />
      </StackPanel>
      <StackPanel x:Name="TextSection">
        <TextBlock Classes="k" Text="{Binding Annotation.FontSizeLabel}" />
        <NumericUpDown x:Name="FontBox" Minimum="6" Maximum="72" Increment="1" FormatString="0" />
        <TextBlock Classes="k" Text="{x:Static res:Strings.Prop_Annot_TextColor}" />
        <WrapPanel x:Name="TextColorSwatches" />
        <TextBlock Classes="k" Text="{x:Static res:Strings.Prop_Annot_Align}" />
        <ComboBox x:Name="AlignBox" HorizontalAlignment="Stretch" />
      </StackPanel>
      <StackPanel x:Name="StampSection">
        <TextBlock Classes="k" Text="{x:Static res:Strings.Prop_Annot_Stamp}" />
        <WrapPanel x:Name="StampButtons" />
        <TextBox x:Name="StampTextBox" Margin="0,6,0,0" PlaceholderText="{x:Static res:Strings.Prop_Annot_StampTextPlaceholder}" />
        <Button x:Name="StampTextBtn" Margin="0,4,0,0" Content="{x:Static res:Strings.Prop_Annot_StampTextApply}" />
        <Button x:Name="StampImageBtn" Margin="0,4,0,0" Content="{x:Static res:Strings.Prop_Annot_StampImage}" />
      </StackPanel>
      <StackPanel x:Name="AttachSection">
        <TextBlock Classes="k" Text="{x:Static res:Strings.Prop_Annot_AttachName}" />
        <TextBlock Classes="v" Text="{Binding Annotation.AttachmentName}" />
        <Button x:Name="AttachSaveBtn" Margin="0,4,0,0" Content="{x:Static res:Strings.Prop_Annot_AttachSave}" />
      </StackPanel>
      <TextBlock Classes="k" Text="{Binding Annotation.OpacityLabel}" />
      <Slider x:Name="OpacitySlider" Minimum="10" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True" />
      <StackPanel x:Name="AuthorSection">
        <TextBlock Classes="k" Text="{x:Static res:Strings.Prop_Annot_Author}" />
        <TextBox x:Name="AuthorBox" Text="{Binding Annotation.Author, Mode=TwoWay}" />
        <TextBlock Classes="k" Text="{x:Static res:Strings.Prop_Annot_Created}" />
        <TextBlock Classes="v" Text="{Binding Annotation.CreatedText}" />
        <TextBlock Classes="k" Text="{x:Static res:Strings.Prop_Annot_Modified}" />
        <TextBlock Classes="v" Text="{Binding Annotation.ModifiedText}" />
      </StackPanel>
    </StackPanel>
    </Panel>
  </ScrollViewer>
</UserControl>
