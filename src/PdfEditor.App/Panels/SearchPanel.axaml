<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="using:PdfEditor.App.Resources"
             xmlns:panels="using:PdfEditor.App.Panels"
             x:Class="PdfEditor.App.Panels.SearchPanel"
             x:DataType="panels:SearchViewModel">
  <DockPanel Margin="{DynamicResource Inset8}">
    <StackPanel DockPanel.Dock="Top" Spacing="{DynamicResource Space4}">
      <TextBox x:Name="QueryBox" Text="{Binding Query, Mode=TwoWay}" PlaceholderText="{x:Static res:Strings.Search_Placeholder}" />
      <CheckBox Content="{x:Static res:Strings.Search_MatchCase}" IsChecked="{Binding MatchCase, Mode=TwoWay}" />
      <CheckBox Content="{x:Static res:Strings.Search_WholeWord}" IsChecked="{Binding WholeWord, Mode=TwoWay}" />
      <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" Margin="0,2" ColumnSpacing="3" RowSpacing="3">
        <Button Grid.Column="0" Content="{x:Static res:Strings.Search_Start}" Command="{Binding SearchCommand}"
                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
        <Button Grid.Column="1" Content="{x:Static res:Strings.Search_Cancel}" Command="{Binding CancelCommand}"
                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
        <Button Grid.Row="1" Grid.Column="0" Content="{x:Static res:Strings.Search_Prev}" Command="{Binding PrevCommand}"
                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
        <Button Grid.Row="1" Grid.Column="1" Content="{x:Static res:Strings.Search_Next}" Command="{Binding NextCommand}"
                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
      </Grid>
      <Button Content="{x:Static res:Strings.Replace_OpenFromSearch}" Command="{Binding OpenReplaceCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
      <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" FontSize="{DynamicResource FontSizeBody}" Foreground="#5C5C5C" />
    </StackPanel>
    <ListBox ItemsSource="{Binding Results}" SelectedItem="{Binding CurrentHit, Mode=TwoWay}" Background="Transparent" Margin="0,4,0,0">
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="panels:SearchHit">
          <StackPanel Margin="0,1">
            <TextBlock Text="{Binding Label}" FontSize="{DynamicResource FontSizeCaption}" Foreground="#005FB8" />
            <TextBlock Text="{Binding Context}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Context}" />
          </StackPanel>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </DockPanel>
</UserControl>
