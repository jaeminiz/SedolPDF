<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="using:PdfEditor.App.Resources"
             xmlns:panels="using:PdfEditor.App.Panels"
             x:Class="PdfEditor.App.Panels.CommentsPanel"
             x:DataType="panels:CommentsViewModel">
  <DockPanel>
    <StackPanel DockPanel.Dock="Top" Margin="8,6,8,4" Spacing="6">
      <TextBlock Text="{Binding ReplyNotice}" IsVisible="{Binding HasReplyNotice}" TextWrapping="Wrap" FontSize="11" Foreground="#8A5A00" />
      <TextBox x:Name="SearchBox" Text="{Binding SearchText}" PlaceholderText="{x:Static res:Strings.Comment_Search}" />
      <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="4">
        <ComboBox ItemsSource="{Binding SortChoices}" SelectedIndex="{Binding SortIndex}" HorizontalAlignment="Stretch"
                  ToolTip.Tip="{x:Static res:Strings.Comment_Sort}" />
        <ToggleButton Grid.Column="1" IsChecked="{Binding SortDescending}" Content="&#x2195;"
                      ToolTip.Tip="{x:Static res:Strings.Comment_Descending}" />
        <Button Grid.Column="2" Content="{x:Static res:Strings.Comment_Filter}">
          <Button.Flyout>
            <Flyout Placement="BottomEdgeAlignedRight">
              <StackPanel Spacing="6" Width="220">
                <ComboBox ItemsSource="{Binding KindChoices}" SelectedIndex="{Binding KindIndex}" HorizontalAlignment="Stretch" />
                <ComboBox ItemsSource="{Binding AuthorChoices}" SelectedIndex="{Binding AuthorIndex}" HorizontalAlignment="Stretch" />
                <ComboBox ItemsSource="{Binding StateChoices}" SelectedIndex="{Binding StateIndex}" HorizontalAlignment="Stretch" />
                <TextBox Text="{Binding PageRange}" PlaceholderText="{x:Static res:Strings.Comment_PageRange}" />
              </StackPanel>
            </Flyout>
          </Button.Flyout>
        </Button>
      </Grid>
      <TextBlock Text="{Binding CountText}" FontSize="11" Foreground="#5C5C5C" />
    </StackPanel>
    <Border DockPanel.Dock="Top" Height="1" Background="#17000000" />
    <Grid>
      <ListBox x:Name="List" ItemsSource="{Binding Items}" Background="Transparent" Padding="0"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled">
        <ListBox.Styles>
          <Style Selector="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinHeight" Value="0" />
          </Style>
        </ListBox.Styles>
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="panels:CommentItem">
            <Border Margin="{Binding Indent}" Padding="8,5" Opacity="{Binding RowOpacity}" BorderBrush="#10000000" BorderThickness="0,0,0,1">
              <StackPanel Spacing="2">
                <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                  <res:IconView Key="{Binding IconKey}" Width="14" Height="14" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="1" Text="{Binding KindName}" FontWeight="SemiBold" Margin="6,0" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                  <Border Grid.Column="2" Background="#14000000" CornerRadius="8" Padding="6,0" VerticalAlignment="Center" IsVisible="{Binding !IsReply}">
                    <TextBlock Text="{Binding PageText}" FontSize="11" />
                  </Border>
                  <Button Grid.Column="3" Name="RowMenuButton" Content="&#x22EF;" Padding="6,0" Margin="4,0,0,0" Background="Transparent" BorderThickness="0"
                          ToolTip.Tip="{x:Static res:Strings.Comment_Menu}" />
                </Grid>
                <TextBlock Text="{Binding AuthorLine}" FontSize="11" Foreground="#5C5C5C" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding Contents}" MaxLines="2" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" />
                <Border IsVisible="{Binding HasState}" HorizontalAlignment="Left" Background="#1A0F6CBD" CornerRadius="8" Padding="8,1">
                  <TextBlock Text="{Binding StateText}" FontSize="11" Foreground="#0F6CBD" />
                </Border>
                <TextBox Name="ReplyBox" Tag="reply" IsVisible="{Binding Ui.IsReplying}" Text="{Binding Ui.Draft, Mode=TwoWay}"
                         AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="120" PlaceholderText="{x:Static res:Strings.Comment_ReplyPlaceholder}" />
              </StackPanel>
            </Border>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <TextBlock Text="{x:Static res:Strings.Comment_Empty}" IsVisible="{Binding IsEmptyList}" Foreground="#5C5C5C" Margin="10" TextWrapping="Wrap"
                 VerticalAlignment="Top" IsHitTestVisible="False" />
    </Grid>
  </DockPanel>
</UserControl>
