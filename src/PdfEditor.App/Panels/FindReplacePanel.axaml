<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="using:PdfEditor.App.Resources"
             xmlns:panels="using:PdfEditor.App.Panels"
             x:Class="PdfEditor.App.Panels.FindReplacePanel"
             x:DataType="panels:FindReplaceViewModel">
  <DockPanel Margin="8,6,8,0">
    <StackPanel DockPanel.Dock="Top" Spacing="4">
      <TextBlock Text="{x:Static res:Strings.Replace_FindLabel}" FontSize="12" Foreground="#5C5C5C" />
      <TextBox x:Name="FindBox" Text="{Binding FindText, Mode=TwoWay}" PlaceholderText="{x:Static res:Strings.Replace_FindPlaceholder}" />
      <TextBlock Text="{x:Static res:Strings.Replace_WithLabel}" FontSize="12" Foreground="#5C5C5C" Margin="0,2,0,0" />
      <TextBox x:Name="WithBox" Text="{Binding ReplaceText, Mode=TwoWay}" PlaceholderText="{x:Static res:Strings.Replace_WithPlaceholder}" />
      <TextBlock Text="{Binding BlockedReason}" IsVisible="{Binding HasBlockedReason}" TextWrapping="Wrap" FontSize="11" Foreground="#8A5A00" />

      <CheckBox Content="{x:Static res:Strings.Replace_MatchCase}" IsChecked="{Binding MatchCase, Mode=TwoWay}" />
      <CheckBox Content="{x:Static res:Strings.Replace_WholeWord}" IsChecked="{Binding WholeWord, Mode=TwoWay}" />
      <CheckBox Content="{x:Static res:Strings.Replace_IdChars}" IsChecked="{Binding IdWordChars, Mode=TwoWay}" IsEnabled="{Binding WholeWord}" Margin="16,0,0,0" />
      <CheckBox Content="{x:Static res:Strings.Replace_IncludeRotated}" IsChecked="{Binding IncludeRotated, Mode=TwoWay}" />

      <WrapPanel Orientation="Horizontal" Margin="0,2,0,0">
        <RadioButton GroupName="ReplaceScope" Margin="0,0,10,0" Content="{x:Static res:Strings.Replace_ScopeAll}" IsChecked="{Binding IsScopeAll, Mode=TwoWay}" />
        <RadioButton GroupName="ReplaceScope" Margin="0,0,10,0" Content="{x:Static res:Strings.Replace_ScopeCurrent}" IsChecked="{Binding IsScopeCurrent, Mode=TwoWay}" />
        <RadioButton GroupName="ReplaceScope" Content="{x:Static res:Strings.Replace_ScopeRange}" IsChecked="{Binding IsScopeRange, Mode=TwoWay}" />
      </WrapPanel>
      <TextBox x:Name="RangeBox" Text="{Binding RangeText, Mode=TwoWay}" PlaceholderText="{x:Static res:Strings.Replace_RangePlaceholder}" IsVisible="{Binding IsScopeRange}" />

      <Grid ColumnDefinitions="*,*,*" Margin="0,4,0,0" ColumnSpacing="4">
        <Button Grid.Column="0" Content="{x:Static res:Strings.Replace_Find}" Command="{Binding FindCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
        <Button Grid.Column="1" Content="{x:Static res:Strings.Replace_Next}" Command="{Binding NextCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
        <Button Grid.Column="2" Content="{x:Static res:Strings.Replace_Cancel}" Command="{Binding CancelCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
      </Grid>
      <Grid ColumnDefinitions="*,*" ColumnSpacing="4">
        <Button Grid.Column="0" Content="{x:Static res:Strings.Replace_ReplaceOne}" Command="{Binding ReplaceCommand}" IsEnabled="{Binding CanReplace}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
        <Button Grid.Column="1" Content="{x:Static res:Strings.Replace_ReplaceAll}" Command="{Binding ReplaceAllCommand}" IsEnabled="{Binding CanReplace}" Classes="accent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
      </Grid>
      <ProgressBar Minimum="0" Maximum="{Binding ProgressMax}" Value="{Binding ProgressValue}" IsVisible="{Binding IsBusy}" Height="4" />
      <TextBlock Text="{Binding SummaryText}" IsVisible="{Binding HasSummary}" TextWrapping="Wrap" FontSize="12" FontWeight="SemiBold" Foreground="#0F7B0F" />
      <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" FontSize="12" Foreground="#5C5C5C" />
      <TextBlock Text="{Binding NoticeText}" IsVisible="{Binding HasNotice}" TextWrapping="Wrap" FontSize="11" Foreground="#8A5A00" />
      <TextBlock Text="{x:Static res:Strings.Replace_Preview}" FontSize="11" Foreground="#5C5C5C" TextWrapping="Wrap" Margin="0,4,0,0" />
      <StackPanel Orientation="Horizontal" Spacing="4">
        <Button Content="{x:Static res:Strings.Replace_CheckAll}" Command="{Binding CheckAllCommand}" Padding="4,1" FontSize="11" />
        <Button Content="{x:Static res:Strings.Replace_UncheckAll}" Command="{Binding UncheckAllCommand}" Padding="4,1" FontSize="11" />
      </StackPanel>
    </StackPanel>
    <ListBox x:Name="ResultList" ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow, Mode=TwoWay}" Background="Transparent" Margin="0,4,0,0"
             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
      <ListBox.Styles>
        <Style Selector="ListBoxItem">
          <Setter Property="Padding" Value="2,2" />
          <Setter Property="MinHeight" Value="0" />
        </Style>
      </ListBox.Styles>
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="panels:ReplaceRow">
          <Grid ColumnDefinitions="Auto,*">
            <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" IsEnabled="{Binding Ok}" MinWidth="0" Margin="0,0,4,0" VerticalAlignment="Top" />
            <StackPanel Grid.Column="1" Spacing="1">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Text="{Binding PageLabel}" FontSize="11" Foreground="#005FB8" />
                <TextBlock Text="{Binding FontLabel}" FontSize="11" Foreground="#5C5C5C" />
              </StackPanel>
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding Before}" MaxWidth="80" TextTrimming="CharacterEllipsis" Foreground="#5C5C5C" />
                <TextBlock Text="{Binding Match}" FontWeight="Bold" />
                <TextBlock Text="{Binding After}" MaxWidth="80" TextTrimming="CharacterEllipsis" Foreground="#5C5C5C" />
              </StackPanel>
              <TextBlock Text="{Binding Note}" IsVisible="{Binding HasNote}" TextWrapping="Wrap" FontSize="11" Foreground="#8A5A00" />
            </StackPanel>
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </DockPanel>
</UserControl>
