<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="using:PdfEditor.App.Resources"
             xmlns:panels="using:PdfEditor.App.Panels"
             x:Class="PdfEditor.App.Panels.ThumbnailsPanel"
             x:DataType="panels:ThumbnailsViewModel">
  <UserControl.Styles>
    <Style Selector="Border.thumb">
      <Setter Property="Background" Value="White" />
      <Setter Property="BorderBrush" Value="#33000000" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Border.thumb.current">
      <Setter Property="BorderBrush" Value="#005FB8" />
      <Setter Property="BorderThickness" Value="2" />
    </Style>
    <Style Selector="ListBox.thumbs > ListBoxItem">
      <Setter Property="Padding" Value="4" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Top" />
    </Style>
  </UserControl.Styles>
  <Grid RowDefinitions="Auto,*">
  <!-- 썸네일 크기: 작은 산 – 슬라이더 – 큰 산 (Acrobat "페이지 축소판"처럼) -->
  <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="10,2,10,4" ToolTip.Tip="{x:Static res:Strings.Tip_ThumbnailSize}">
    <Path Grid.Column="0" Data="M1,12 L5,6 L8,10 L11,5 L15,12 Z" Fill="#5C5C5C" Width="16" Height="14" Stretch="Uniform" VerticalAlignment="Center" />
    <Slider Grid.Column="1" x:Name="SizeSlider" Minimum="64" Maximum="256" Value="{Binding Size, Mode=TwoWay}" Margin="6,0"
            VerticalAlignment="Center" AutomationProperties.Name="{x:Static res:Strings.Tip_ThumbnailSize}" />
    <Path Grid.Column="2" Data="M1,12 L5,6 L8,10 L11,5 L15,12 Z" Fill="#5C5C5C" Width="22" Height="19" Stretch="Uniform" VerticalAlignment="Center" />
  </Grid>
  <Grid Grid.Row="1" x:Name="DropHost">
  <ListBox x:Name="List" Classes="thumbs" ItemsSource="{Binding Items}" SelectionMode="Multiple" DragDrop.AllowDrop="True"
           Background="Transparent" Padding="0,4"
           ScrollViewer.HorizontalScrollBarVisibility="Disabled">
    <ListBox.ItemsPanel>
      <ItemsPanelTemplate><panels:ThumbnailGridPanel CellWidth="{Binding CellWidth}" CellHeight="{Binding CellHeight}" /></ItemsPanelTemplate>
    </ListBox.ItemsPanel>
    <ListBox.ItemTemplate>
      <DataTemplate x:DataType="panels:ThumbnailItem">
        <StackPanel Spacing="2" HorizontalAlignment="Center">
          <Border Classes="thumb" Classes.current="{Binding IsCurrent}"
                  Width="{Binding DisplayWidth}" Height="{Binding DisplayHeight}">
            <Grid>
              <Image Source="{Binding Source}" Stretch="Uniform" />
              <panels:ThumbnailAnnotationLayer />
            </Grid>
          </Border>
          <TextBlock Text="{Binding PageNumber}" HorizontalAlignment="Center" FontSize="{DynamicResource FontSizeCaption}" Foreground="#5C5C5C" />
        </StackPanel>
      </DataTemplate>
    </ListBox.ItemTemplate>
    <ListBox.ContextMenu>
      <ContextMenu x:DataType="panels:ThumbnailsViewModel">
        <MenuItem Header="{x:Static res:Strings.Cmd_PageDelete}" Command="{Binding Commands.DeleteCommand}" />
        <MenuItem Header="{x:Static res:Strings.Cmd_PageRotateLeft}" Command="{Binding Commands.RotateLeftCommand}" />
        <MenuItem Header="{x:Static res:Strings.Cmd_PageRotateRight}" Command="{Binding Commands.RotateRightCommand}" />
        <MenuItem Header="{x:Static res:Strings.Cmd_PageInsertBlank}" Command="{Binding Commands.InsertBlankCommand}" />
        <MenuItem Header="{x:Static res:Strings.Cmd_PageInsertFromFile}" Command="{Binding Commands.InsertFromFileCommand}" />
        <Separator />
        <MenuItem Header="{x:Static res:Strings.Cmd_PageExtract}" Command="{Binding Commands.ExtractCommand}" />
      </ContextMenu>
    </ListBox.ContextMenu>
  </ListBox>
  <!-- 쪽을 끌어 옮길 때 놓일 자리를 보여 주는 선 -->
  <Border x:Name="DropLine" Width="3" Height="3" CornerRadius="1.5" Background="#005FB8" VerticalAlignment="Top"
          HorizontalAlignment="Left" IsHitTestVisible="False" IsVisible="False" />
  </Grid>
  </Grid>
</UserControl>
